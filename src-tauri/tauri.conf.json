{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumina",
  "identifier": "com.kurtddanielbigtas.lumina",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumina",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3NzJEMTU0NEVFMDE4QkQKUldTOUdPQk9WTkZ5RjFmK2RZWDEvenlGK1dQRXRWVkN3SllwamYxWFQ4U0VxdWJzcGhWMkhCYnQK",
      "endpoints": [
        "https://kertsu.github.io/lumina-releases/updates/beta.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../LICENSE": "notices/LICENSE",
      "../crates/lumina-persistence/seed/NOTICE.html": "notices/WEB-NOTICE.html",
      "../crates/lumina-persistence/seed/provenance.json": "notices/WEB-provenance.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 720,
          "height": 460
        },
        "appPosition": {
          "x": 188,
          "y": 258
        },
        "applicationFolderPosition": {
          "x": 532,
          "y": 258
        }
      }
    }
  }
}
