{
    "name": "lumina",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.30.1",
    "scripts": {
        "dev:vite": "vite dev --port 3000",
        "build:vite": "vite build",
        "preview:vite": "vite preview",
        "test": "vitest run",
        "tauri": "tauri",
        "format": "biome format",
        "lint": "biome check",
        "lint:ci": "biome ci .",
        "fix": "biome check --write",
        "typecheck": "tsc --noEmit",
        "check": "pnpm check:frontend && pnpm check:rust",
        "check:frontend": "pnpm lint:ci && pnpm typecheck && pnpm test && pnpm test:release",
        "check:rust": "pnpm rust:fmt && pnpm bindings:check && pnpm rust:clippy && pnpm rust:test",
        "rust:fmt": "cargo fmt --all -- --check",
        "rust:clippy": "cargo clippy --workspace --all-targets --locked -- -D warnings",
        "rust:test": "cargo test --workspace --locked",
        "dev": "tauri dev",
        "build": "tauri build",
        "bindings:generate": "node scripts/bindings.mjs",
        "bindings:check": "node scripts/bindings.mjs --check",
        "test:release": "node --test scripts/release.node-test.mjs scripts/updater-poc.node-test.mjs scripts/publish-release.node-test.mjs scripts/notices.node-test.mjs scripts/downloads.node-test.mjs",
        "updater:poc": "node scripts/updater-poc.mjs"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "@radix-ui/react-slot": "^1.5.0",
        "@tailwindcss/vite": "^4.2.4",
        "@tanstack/react-devtools": "^0.10.2",
        "@tanstack/react-router": "^1.169.2",
        "@tanstack/react-router-devtools": "^1.166.13",
        "@tauri-apps/api": "^2.11.0",
        "@tauri-apps/plugin-opener": "^2.5.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.2.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.14",
        "@tanstack/devtools-vite": "^0.6.0",
        "@tanstack/router-plugin": "^1.167.35",
        "@tauri-apps/cli": "^2.11.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "jsdom": "^29.1.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.10",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.5",
        "web-vitals": "^5.2.0"
    }
}
